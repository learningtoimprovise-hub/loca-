# ════════════════════════════════════════════════════════════════
#  LOCA AGENCY BACKEND — ENVIRONMENT VARIABLES
#  Copy this file to .env for local development.
#  On Render: add each of these under
#  Dashboard → your service → Environment → Environment Variables
# ════════════════════════════════════════════════════════════════

# ─── SERVER ─────────────────────────────────────────────────────
PORT=3000

# ─── CORS ───────────────────────────────────────────────────────
# Set to your live frontend domain in production, e.g. https://locaagency.com
# "*" allows all (fine while the frontend is served by this same server,
# as it is by default).
ALLOWED_ORIGIN=*

# ─── ADMIN ACCESS ───────────────────────────────────────────────
# Required to use /api/leads, /api/stats, /api/test-email, etc.
# Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me-before-deploying

# ═══════════════════════════════════════════════════════════════
#  EMAIL (Nodemailer)
#  This is the most common source of "form works but no email
#  arrives" issues. Read carefully — PORT and SMTP_SECURE must
#  match each other.
# ═══════════════════════════════════════════════════════════════

# ── Option A: Hostinger custom-domain email (recommended for
#    hello@locaagency.com) ────────────────────────────────────────
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=hello@locaagency.com
# SMTP_PASS=your-mailbox-password

# ── Option B: Gmail (App Password required, 2FA must be enabled) ─
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-app-password

# Active config (defaults below are Gmail-style port 587/STARTTLS).
# IMPORTANT: 465 -> SMTP_SECURE=true (implicit TLS). 587 -> SMTP_SECURE=false
# (STARTTLS). Mismatching these two is the #1 cause of silent email
# failures. If SMTP_SECURE is left unset, it's auto-derived from
# SMTP_PORT (465 = true, anything else = false).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password-or-app-password

# Email address(es) that receive new lead notifications.
# Comma-separate for multiple recipients:
#   NOTIFY_EMAIL=hello@locaagency.com,founder@gmail.com
# Defaults to SMTP_USER if not set.
NOTIFY_EMAIL=hello@locaagency.com

# Optional - override the "From" address shown to recipients.
# Defaults to SMTP_USER. Only set if your SMTP provider allows
# sending "on behalf of" a different verified address.
# EMAIL_FROM=hello@locaagency.com

# Optional - display name in the "From" field. Defaults to "LOCA Agency".
# EMAIL_FROM_NAME=LOCA Agency

# Optional - "true" prints the full SMTP conversation to logs for
# deep debugging. Turn off again once resolved (verbose).
# SMTP_DEBUG=false

# ═══════════════════════════════════════════════════════════════
#  OPTIONAL: TELEGRAM INSTANT LEAD ALERTS (backup channel)
#  Get a push notification on your phone the moment a lead comes
#  in - independent of email/SMTP. Leave blank to disable.
#
#  Setup:
#   1. Message @BotFather on Telegram -> /newbot -> copy the token
#   2. Message your new bot once, then visit:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#      to find your numeric chat id
# ═══════════════════════════════════════════════════════════════
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
